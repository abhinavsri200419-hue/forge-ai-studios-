# --- Database ---
DATABASE_URL="postgresql://user:password@localhost:5432/forge_ai_studios?schema=public"

# --- Auth ---
JWT_SECRET="replace-with-a-long-random-string"

# --- SMTP / Email ---
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="marketingwithforge@gmail.com"
SMTP_PASS="your-smtp-app-password"
EMAIL_FROM="marketingwithforge@gmail.com"
ADMIN_EMAIL="marketingwithforge@gmail.com"

# --- Google Calendar / Meet ---
# Create an OAuth 2.0 Client (Web application) in Google Cloud Console,
# enable the Google Calendar API, and generate a refresh token once via
# the OAuth consent flow (see README "Google Calendar setup").
GOOGLE_CLIENT_ID="xxxxxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="xxxxxxxx"
GOOGLE_REFRESH_TOKEN="xxxxxxxx"
GOOGLE_CALENDAR_ID="primary"

# --- CORS ---
# Set to your production domain (e.g. https://forgeaistudios.com) once deployed.
ALLOWED_ORIGIN="*"

# --- One-time admin seed (used only by scripts/seed-admin.ts) ---
SEED_ADMIN_NAME="Forge Admin"
SEED_ADMIN_EMAIL="admin@forgeaistudios.com"
SEED_ADMIN_PASSWORD="change-this-before-running-in-prod"
